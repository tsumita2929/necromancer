index 0000000..232273e
--- /dev/null
+++ b/test/seance.request.test.js
@@ -0,0 +1,419 @@
+'use strict';
+
+// séance: request vs fetch
+//
+// A differential property-based test. It asks the OLD functions (test/old-rates.js, a frozen
+// copy of the original request-based src/rates.js) and the NEW functions (src/rates.js) the
+// same generated question against a local HTTP server and compares everything the project can
+// observe: the resolved value or the kind of rejection, and every request the server received
+// (method, path with the raw query string, headers, body).
+//
+//   npm test                                   live séance (while `request` is installed) +
+//                                              replay of the recorded answers of `request`
+//   SEANCE_RECORD=1 node --test test/seance.request.test.js
+//                                              re-record test/seance.request.golden.json from OLD
+//   SEANCE_RUNS=500 npm test                   more generated cases (default 100)
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const http = require('node:http');
+const fs = require('node:fs');
+const path = require('node:path');
+const util = require('node:util');
+const fc = require('fast-check');
+
+const NEW = require('../src/rates');
+
+let OLD = null;
+try {
+  require.resolve('request');
+  OLD = require('./old-rates');
+} catch (err) {
+  if (err.code !== 'MODULE_NOT_FOUND') throw err;
+}
+
+const GOLDEN = path.join(__dirname, 'seance.request.golden.json');
+const RUNS = Number(process.env.SEANCE_RUNS) || 100;
+
+// Headers that the HTTP client adds by itself, that neither implementation of the project sets
+// and that the project never reads. They are listed here, not silently dropped; see
+// "Known behavioural differences" in .kiro/specs/migrate-off-request/design.md.
+//   host: derived from the URL (the two servers listen on different ports)
+//   connection, keep-alive: transport (request closes the socket, fetch keeps it alive)
+//   accept-encoding, accept-language, sec-fetch-mode: added by fetch, absent with request
+const IGNORED_HEADERS = new Set([
+  'host',
+  'connection',
+  'keep-alive',
+  'accept-encoding',
+  'accept-language',
+  'sec-fetch-mode',
+]);
+
+// ---------------------------------------------------------------------------------------------
+// Generators: the domain of the two call sites in src/rates.js
+// ---------------------------------------------------------------------------------------------
+
+// Query values and text: empty, spaces, unicode, characters that need escaping, lone surrogates,
+// very long strings.
+const RESERVED = " &=+%#?/\\~!*'()@:;,$[]{}\"<>|^`-_.\r\n\t\0";
+const textArb = fc.oneof(
+  { weight: 4, arbitrary: fc.constantFrom('USD', 'EUR', 'JPY', 'GBP', 'BTC') },
+  {
+    weight: 3,
+    arbitrary: fc.constantFrom(
+      '', ' ', '  ', 'a b', 'ü', '日本語', '€', '😀', 'e\u0301', 'a&b=c', 'a+b', '100%', '%41', '%',
+      '#', '?', '/', '\\', '~', "!'()*", '\0', '\n', '\ud800', 'a\udc00b', '\ufeff', '__proto__',
+      'constructor', 'toString',
+    ),
+  },
+  { weight: 3, arbitrary: fc.string({ unit: 'grapheme', maxLength: 12 }) },
+  { weight: 2, arbitrary: fc.string({ unit: 'binary', maxLength: 12 }) },
+  {
+    weight: 3,
+    arbitrary: fc.string({
+      unit: fc.oneof(fc.constantFrom(...RESERVED), fc.constantFrom('a', 'Z', '0', 'é', '日', '😀')),
+      maxLength: 16,
+    }),
+  },
+  { weight: 1, arbitrary: fc.string({ unit: 'grapheme', minLength: 1500, maxLength: 3000 }) },
+);
+
+const jsonTextArb = fc
+  .tuple(fc.jsonValue(), fc.constantFrom(0, 2))
+  .map(([value, spaces]) => JSON.stringify(value, null, spaces));
+
+const toHex = (bytes) => Buffer.from(bytes).toString('hex');
+
+// What the server sends back (JSON-serialisable, so that it can go into the golden file).
+const bodyArb = fc.oneof(
+  { weight: 5, arbitrary: fc.record({ kind: fc.constant('rates'), rate: fc.double({ noNaN: true, noDefaultInfinity: true }), spaces: fc.constantFrom(0, 2) }) },
+  { weight: 3, arbitrary: fc.record({ kind: fc.constant('ratesShape'), shape: fc.constantFrom('empty', 'string', 'null', 'array', 'nested', 'ratesNull', 'ratesString', 'noRates') }) },
+  { weight: 3, arbitrary: fc.record({ kind: fc.constant('json'), text: jsonTextArb }) },
+  { weight: 3, arbitrary: fc.record({ kind: fc.constant('text'), text: textArb }) },
+  { weight: 2, arbitrary: fc.record({ kind: fc.constant('badJson'), text: jsonTextArb, cut: fc.nat(40) }) },
+  { weight: 2, arbitrary: fc.record({ kind: fc.constant('empty') }) },
+  { weight: 1, arbitrary: fc.record({ kind: fc.constant('bom'), text: jsonTextArb }) },
+  { weight: 2, arbitrary: fc.record({ kind: fc.constant('bytes'), hex: fc.uint8Array({ maxLength: 48 }).map(toHex) }) },
+  { weight: 1, arbitrary: fc.record({ kind: fc.constant('bomRates'), rate: fc.double({ noNaN: true, noDefaultInfinity: true }) }) },
+);
+
+const contentTypeArb = fc.constantFrom(
+  null,
+  'application/json',
+  'application/json; charset=utf-8',
+  'application/vnd.api+json',
+  'text/plain',
+  'text/plain; charset=iso-8859-1',
+  'text/html',
+  'application/octet-stream',
+);
+
+// Timing is generated as a class, each delay clearly below (fast) or clearly above (slow)
+// timeoutMs, with a margin of 60 ms. An answer that lands within the margin of the deadline is
+// decided by event-loop jitter in either implementation, so such cases are not generated.
+const MARGIN = 60;
+const timingArb = fc.oneof(
+  {
+    weight: 5, // fast: every gap shorter than the timeout, but the gaps may add up past it
+    arbitrary: fc.integer({ min: 80, max: 200 }).chain((timeoutMs) =>
+      fc.record({
+        timeoutMs: fc.constant(timeoutMs),
+        headDelay: fc.integer({ min: 0, max: timeoutMs - MARGIN }),
+        bodyDelay: fc.integer({ min: 0, max: timeoutMs - MARGIN }),
+      }),
+    ),
+  },
+  {
+    weight: 2, // the answer does not start in time
+    arbitrary: fc.integer({ min: 80, max: 200 }).chain((timeoutMs) =>
+      fc.record({
+        timeoutMs: fc.constant(timeoutMs),
+        headDelay: fc.integer({ min: timeoutMs + MARGIN, max: timeoutMs + 150 }),
+        bodyDelay: fc.constant(0),
+      }),
+    ),
+  },
+  {
+    weight: 2, // the headers arrive, the body stalls
+    arbitrary: fc.integer({ min: 80, max: 200 }).chain((timeoutMs) =>
+      fc.record({
+        timeoutMs: fc.constant(timeoutMs),
+        headDelay: fc.integer({ min: 0, max: timeoutMs - MARGIN }),
+        bodyDelay: fc.integer({ min: timeoutMs + MARGIN, max: timeoutMs + 150 }),
+      }),
+    ),
+  },
+  {
+    weight: 1, // no timeoutMs: the project default applies
