+  if (util.isDeepStrictEqual(expected, actual)) return;
+  const message =
+    `${names[0]} and ${names[1]} differ\n` +
+    `case: ${describeCase(c)}\n` +
+    `${names[0]}: ${JSON.stringify(expected, null, 1)}\n` +
+    `${names[1]}: ${JSON.stringify(actual, null, 1)}`;
