 'use strict';
 
-const leftPad = require('left-pad');
+const { padLeft } = require('./pad');
 const moment = require('moment');
 
 const QTY_WIDTH = 4;
@@ -31,7 +31,7 @@ function renderReceipt(order, options) {
   const nameWidth = Math.max(width - QTY_WIDTH - PRICE_WIDTH, 1);
 
   const lines = [];
-  lines.push(padRight('HAUNTED CAFE', width - 9) + '#' + leftPad(order.id, 8, '0'));
+  lines.push(padRight('HAUNTED CAFE', width - 9) + '#' + padLeft(order.id, 8, '0'));
   lines.push(moment(order.placedAt).utc().format('YYYY-MM-DD HH:mm') + ' UTC');
   lines.push('-'.repeat(width));
 
@@ -41,14 +41,14 @@ function renderReceipt(order, options) {
     total += cents;
     lines.push(
       padRight(item.name, nameWidth) +
-        leftPad('x' + item.qty, QTY_WIDTH) +
-        leftPad(money(cents, symbol), PRICE_WIDTH, fill),
+        padLeft('x' + item.qty, QTY_WIDTH) +
+        padLeft(money(cents, symbol), PRICE_WIDTH, fill),
     );
   }
 
   lines.push('-'.repeat(width));
   lines.push(
-    padRight('TOTAL', width - PRICE_WIDTH) + leftPad(money(total, symbol), PRICE_WIDTH, fill),
+    padRight('TOTAL', width - PRICE_WIDTH) + padLeft(money(total, symbol), PRICE_WIDTH, fill),
   );
   return lines.join('\n');
 }
