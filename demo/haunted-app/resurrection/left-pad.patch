+++ b/src/pad.js
@@ -0,0 +1,20 @@
+'use strict';
+
+/**
+ * Pad `value` on the left up to `width`, using the platform's String.prototype.padStart.
+ * This replaces the dead `left-pad` package. See
+ * .kiro/specs/migrate-off-left-pad/design.md for the behavioural differences.
+ *
+ * - `value` is turned into a string first (left-pad accepted numbers).
+ * - `fill` that is missing, empty, null, false or NaN pads with spaces, as left-pad did.
+ *   (padStart would not pad at all for '' and would write "null" or "false" for the others.)
+ *   Any other `fill` is used as a string, so the number 0 pads with "0".
+ * - A `fill` longer than one character is repeated and cut at `width`, so the result is
+ *   exactly `width` long. left-pad wrote the whole fill every time and overshot `width`.
+ */
+function padLeft(value, width, fill) {
+  const pad = !fill && fill !== 0 ? ' ' : String(fill);
+  return String(value).padStart(width, pad);
+}
+
+module.exports = { padLeft };
diff --git a/test/seance.leftpad.test.js b/test/seance.leftpad.test.js
new file mode 100644
index 0000000..2be3aa9
--- /dev/null
+++ b/test/seance.leftpad.test.js
@@ -0,0 +1,222 @@
+'use strict';
+
+// Séance: ask the dead package (left-pad) and its successor (String.prototype.padStart,
+// through the project's src/pad.js) the same generated questions and fail on any difference.
+//
+// The questions are the call shapes in src/receipt.js:
+//   order number   leftPad(order.id, 8, '0')
+//   quantity       leftPad('x' + item.qty, 4)
+//   money column   leftPad(money(cents, symbol), 10, fill)   fill is a free user option
+// plus the same call with arbitrary widths, because the receipt `width` option feeds
+// width-derived columns and the séance should not depend on the two constants 4 and 10.
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fc = require('fast-check');
+const leftPad = require('left-pad');
+const { padLeft } = require('../src/pad');
+
+const RUNS = Number(process.env.SEANCE_RUNS || 1000);
+
+// ---- helpers ---------------------------------------------------------------------
+
+// Run a call and describe the outcome: the value, or the kind (class name) of the error.
+function outcome(fn) {
+  try {
+    return { value: fn() };
+  } catch (err) {
+    return { threw: err && err.constructor ? err.constructor.name : typeof err };
+  }
+}
+
+function show(x) {
+  return JSON.stringify(x, (_k, v) =>
+    v === undefined ? '__undefined__' : typeof v === 'number' && !Number.isFinite(v) ? String(v) : v,
+  );
+}
+
+// fast-check puts the property's own error in `error.cause`, which node:test does not print.
+// Fold it into the message so a failure shows the shrunk input and both answers.
+function assertProperty(property) {
+  try {
+    fc.assert(property, { numRuns: RUNS });
+  } catch (err) {
+    throw new Error(err.message + (err.cause ? '\n\n' + err.cause.message : ''));
+  }
+}
+
+// KNOWN DIFFERENCE (decided in .kiro/specs/migrate-off-left-pad/design.md):
+// when the fill is longer than one character and the value is shorter than the width,
+// left-pad writes the whole fill once per missing column (the line overshoots `width`),
+// while padStart repeats the fill and cuts it at `width`. The project accepts the padStart
+// result. The séance does not skip these inputs: it asserts the accepted contract for them
+// and asserts that left-pad really does differ, so the exception cannot go stale.
+function fillAsString(fill) {
+  return !fill && fill !== 0 ? ' ' : String(fill);
+}
+
+function isKnownDifference({ value, width, fill }) {
+  return fillAsString(fill).length > 1 && String(value).length < width;
+}
+
+// Ask both sides. `input` is { value, width, fill }; fill is left out for the 2-argument call.
+function ask(oldFn, newFn, input, { acceptKnownDifference = true } = {}) {
+  const was = outcome(oldFn);
+  const now = outcome(newFn);
+  if (acceptKnownDifference && isKnownDifference(input)) {
+    assert.deepStrictEqual(
+      now,
+      { value: String(input.value).padStart(input.width, fillAsString(input.fill)) },
+      `accepted padStart contract broken for input ${show(input)}\n  new: ${show(now)}`,
+    );
+    assert.ok(
+      typeof was.value === 'string' && was.value.length > input.width,
+      `left-pad no longer overshoots the width, so the known difference is stale for ${show(input)}\n  left-pad: ${show(was)}`,
+    );
+    return;
+  }
+  assert.deepStrictEqual(
+    now,
+    was,
+    `left-pad and padStart disagree for input ${show(input)}\n  left-pad: ${show(was)}\n  padStart: ${show(now)}`,
+  );
+}
+
+// ---- generators (the real domain of each call site) ------------------------------
+
+// order.id is documented as a number; the receipt does not validate it, so draw integers
+// (small, large, negative, zero), arbitrary doubles (fractions, NaN, infinities, -0) and
+// strings (ids that came in as text).
+const orderId = fc.oneof(
+  fc.integer({ min: 0, max: 99999999 }),
+  fc.integer({ min: -1000, max: 1000 }),
+  fc.double(),
+  fc.maxSafeInteger(),
+  fc.string({ unit: 'binary', maxLength: 12 }),
+);
+
+// item.qty is a number; the column value is 'x' + qty.
+const qtyColumn = fc
+  .oneof(fc.integer({ min: -5, max: 100000 }), fc.double(), fc.string({ maxLength: 6 }))
+  .map((qty) => 'x' + qty);
+
+// money(cents, symbol) is symbol + (cents / 100).toFixed(2); symbol is a free option.
+const moneyColumn = fc
+  .tuple(
+    fc.string({ unit: 'binary', maxLength: 4 }),
+    fc.oneof(fc.integer({ min: -100000000, max: 100000000 }), fc.integer({ min: -1000, max: 1000 })),
+  )
+  .map(([symbol, cents]) => symbol + (cents / 100).toFixed(2));
+
+// Any value at all: numbers, and strings that are empty, long or unicode.
+const anyText = fc.oneof(
+  fc.string({ unit: 'binary', maxLength: 30 }),
+  fc.string({ unit: 'grapheme', maxLength: 30 }),
+  fc.string({ maxLength: 300 }),
+  fc.constant(''),
+);
+const anyValue = fc.oneof(orderId, anyText);
+
+// Widths: negative, zero, small, the project's constants, and large.
+const width = fc.oneof(
+  fc.integer({ min: -5, max: 20 }),
+  fc.constantFrom(0, 1, 4, 8, 10),
+  fc.integer({ min: 0, max: 200 }),
+  fc.integer({ min: 200, max: 5000 }),
+);
+
+// `fill` is a free option: any short string, including '', single characters and
+// multi-character strings (with unicode and whitespace).
+const fillOption = fc.oneof(
+  fc.constant(''),
+  fc.constant(' '),
+  fc.constantFrom('0', '.', '*', '-', '\u00b7', '\u{1F47B}', 'ab', '..', '<>', '\u{1F47B}\u{1F383}'),
+  fc.string({ minLength: 1, maxLength: 1 }),
+  fc.string({ unit: 'binary', minLength: 0, maxLength: 4 }),
+  fc.string({ unit: 'grapheme', minLength: 0, maxLength: 3 }),
+);
+
+// The option is not validated, so a config file or a caller can also hand over a
+// non-string: null, booleans, numbers (0 is a real fill for left-pad), NaN.
+const nonStringFill = fc.oneof(
+  fc.constantFrom(null, false, true, 0, -0, NaN, 1, 7, -3, 1.5),
+  fc.integer({ min: -1000, max: 1000 }),
+  fc.double(),
+);
+
+// ---- tests -----------------------------------------------------------------------
+
+test('séance harness: left-pad vs left-pad (old versus old)', () => {
+  assertProperty(
+    fc.property(anyValue, width, fc.oneof(fillOption, nonStringFill), (value, w, fill) => {
+      ask(() => leftPad(value, w, fill), () => leftPad(value, w, fill), { value, width: w, fill }, { acceptKnownDifference: false });
+    }),
+  );
+});
+
+test('séance: left-pad vs String.prototype.padStart (order number, fill 0, width 8)', () => {
+  assertProperty(
+    fc.property(orderId, (id) => {
+      ask(() => leftPad(id, 8, '0'), () => padLeft(id, 8, '0'), { value: id, width: 8, fill: '0' });
+    }),
+  );
+});
+
+test('séance: left-pad vs String.prototype.padStart (quantity column, no fill, width 4)', () => {
+  assertProperty(
+    fc.property(qtyColumn, (text) => {
+      ask(() => leftPad(text, 4), () => padLeft(text, 4), { value: text, width: 4 });
+    }),
+  );
+});
+
+test('séance: left-pad vs String.prototype.padStart (money column, free fill option, width 10)', () => {
+  assertProperty(
+    fc.property(moneyColumn, fillOption, (text, fill) => {
+      ask(() => leftPad(text, 10, fill), () => padLeft(text, 10, fill), { value: text, width: 10, fill });
+    }),
+  );
+});
+
+test('séance: left-pad vs String.prototype.padStart (any value, any width, any string fill)', () => {
+  assertProperty(
+    fc.property(anyValue, width, fillOption, (value, w, fill) => {
+      ask(() => leftPad(value, w, fill), () => padLeft(value, w, fill), { value, width: w, fill });
+    }),
+  );
+});
+
+test('séance: left-pad vs String.prototype.padStart (any value, any width, non-string fill)', () => {
+  assertProperty(
+    fc.property(anyValue, width, nonStringFill, (value, w, fill) => {
+      ask(() => leftPad(value, w, fill), () => padLeft(value, w, fill), { value, width: w, fill });
+    }),
+  );
+});
+
+test('séance: left-pad vs String.prototype.padStart (any value, any width, no fill)', () => {
+  assertProperty(
+    fc.property(anyValue, width, (value, w) => {
+      ask(() => leftPad(value, w), () => padLeft(value, w), { value, width: w });
+    }),
+  );
+});
+
+test('séance: known difference, a fill longer than one character, is pinned', () => {
+  // Make sure the exception above is exercised: left-pad overshoots, padLeft hits the width.
+  assert.equal(leftPad('$6.00', 10, 'ab'), 'ababababab$6.00');
+  assert.equal(padLeft('$6.00', 10, 'ab'), 'ababa$6.00');
+  assert.equal(padLeft('$6.00', 10, 'ab').length, 10);
+  // Counted over generated inputs, so a change in left-pad or in padLeft is noticed.
+  let seen = 0;
+  assertProperty(
+    fc.property(anyValue, width, fillOption, (value, w, fill) => {
+      if (isKnownDifference({ value, width: w, fill })) {
+        seen += 1;
+        assert.ok(padLeft(value, w, fill).length === Math.max(w, String(value).length));
+        assert.ok(leftPad(value, w, fill).length > w);
+      }
+    }),
+  );
