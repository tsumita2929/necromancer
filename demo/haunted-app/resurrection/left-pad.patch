+      return { ...entry, len: was.value.length, sha: sha(was.value), ...(was.value.length <= 64 ? { text: was.value } : {}) };
+    });
+    fs.writeFileSync(GOLDEN, JSON.stringify({ package: 'left-pad@1.3.0', entries }, null, 0) + '\n');
+  });
+}
+
+test('séance: padLeft vs the recorded answers of left-pad', () => {
+  const { entries } = JSON.parse(fs.readFileSync(GOLDEN, 'utf8'));
+  assert.ok(entries.length > 1000, 'the golden file is missing its entries');
+  let accepted = 0;
+  for (const e of entries) {
+    const input = { value: decode(e.value), width: e.width, fill: decode(e.fill) };
+    if (e.threw) {
+      assert.deepStrictEqual(outcome(() => callNew(input)), { threw: e.threw }, `padLeft differs for ${show(input)}`);
+    } else if (isKnownDifference(input)) {
+      accepted += 1;
+      assert.ok(e.len > input.width, `left-pad no longer overshoots the width, so the known difference is stale for ${show(input)}`);
+      assert.equal(callNew(input), String(input.value).padStart(input.width, fillAsString(input.fill)), `accepted padStart contract broken for ${show(input)}`);
+    } else {
+      const now = callNew(input);
+      assert.ok(
+        now.length === e.len && sha(now) === e.sha,
+        `left-pad and padStart disagree for input ${show(input)}\n  left-pad: ${e.text === undefined ? `${e.len} characters, sha256 ${e.sha}` : show(e.text)}\n  padStart: ${now.length <= 64 ? show(now) : `${now.length} characters, sha256 ${sha(now)}`}`,
+      );
+    }
+  }
+  assert.ok(accepted > 0, 'the golden file holds no multi-character fill');
+});
-- 
