+  fc.constantFrom(undefined, 0, NaN, null, false, '', Infinity, '5', 'abc', true),
+  fc.integer({ min: 1000, max: 5000 }),
+);
+const timing = fc.oneof(
+  { weight: 8, arbitrary: fc.record({ delay: fc.constant('none'), timeout: NO_EXPIRY }) },
+  { weight: 2, arbitrary: fc.record({ delay: fc.constant('slow'), timeout: NO_EXPIRY }) },
+  { weight: 2, arbitrary: fc.record({ delay: fc.constant('slow'), timeout: fc.integer({ min: 50, max: 150 }) }) },
+  { weight: 1, arbitrary: fc.record({ delay: fc.constant('hang'), timeout: fc.integer({ min: 50, max: 300 }) }) },
+  { weight: 1, arbitrary: fc.record({ delay: fc.constant('drip'), timeout: fc.integer({ min: 1000, max: 2000 }) }) },
+  { weight: 1, arbitrary: fc.record({ delay: fc.constant('drip'), timeout: fc.integer({ min: 50, max: 150 }) }) },
+);
+
+const serverScript = (timingArb) =>
+  fc
+    .record({ t: timingArb, r: redirects, status, ctype, body: rateBody, reset: fc.oneof({ weight: 20, arbitrary: fc.constant(false) }, { weight: 1, arbitrary: fc.constant('before') }, { weight: 1, arbitrary: fc.constant('mid') }) })
+    .map(({ t, r, status, ctype, body, reset }) => ({ timeout: t.timeout, server: { delay: t.delay, ...r, status, ctype, body, reset } }));
