+  fc.oneof(
+    { weight: 4, arbitrary: fc.constantFrom('', '', '/api', '/v1/') },
+    {
+      weight: 3,
+      arbitrary: fc
+        .tuple(fc.constantFrom('/', '/', '/', '#', ...(allowQuery ? ['?'] : [])), fc.string({ unit: fc.constantFrom(...PREFIX_UNITS), maxLength: 12 }))
+        .map(([lead, rest]) => lead + rest)
