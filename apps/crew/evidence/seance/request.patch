+        throw new Error('Exceeded maxRedirects. Probably stuck in a redirect loop ' + uri.href);
+      }
+      redirects += 1;
+      const next = /^https?:/.test(location) ? location : resolveUrl(uri.href, location);
+      const prev = uri;
+      uri = parseUrl(next);
+      if (!hasHost(uri)) throw invalidUri(next);
+      if (uri.protocol !== 'http:' && uri.protocol !== 'https:') throw invalidProtocol(uri);
