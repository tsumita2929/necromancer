+  {
+    weight: 12,
+    arbitrary: fc.record({
+      kind: fc.constant('server'),
+      scheme: fc.oneof({ weight: 12, arbitrary: fc.constant('http') }, { weight: 1, arbitrary: fc.constant('https') }),
+      userinfo: fc.oneof({ weight: 5, arbitrary: fc.constant('') }, { weight: 1, arbitrary: fc.constantFrom('user:pw@', 'u@', ':@', 'u%40x:p%3Aw@', 'a:b:c@') }),
