+//
+// Parts ported from request's own dependencies, so the bytes on the wire stay the same:
+//   - qs@6.5.5 `stringify`/`utils.encode` (BSD-3-Clause), for primitive values only
+//   - json-stringify-safe@5.0.1 (ISC)
+import { parse as parseUrl, resolve as resolveUrl } from 'node:url';
+
+export const READY = true;
+
+const SUPPORTED = new Set(['url', 'uri', 'qs', 'headers', 'json', 'timeout']);
+const MAX_REDIRECTS = 10;
+
+// ---- qs.stringify for primitives (qs@6.5.5, RFC 3986 encoding) -------------------------------
+const hexTable = [];
+for (let i = 0; i < 256; ++i) hexTable.push('%' + ((i < 16 ? '0' : '') + i.toString(16)).toUpperCase());
+
+function qsEncode(value) {
+  const str = value;
+  if (str.length === 0) return str;
+  const string = typeof str === 'string' ? str : String(str);
+  let out = '';
+  for (let i = 0; i < string.length; ++i) {
+    let c = string.charCodeAt(i);
+    if (c === 0x2d || c === 0x2e || c === 0x5f || c === 0x7e ||
+        (c >= 0x30 && c <= 0x39) || (c >= 0x41 && c <= 0x5a) || (c >= 0x61 && c <= 0x7a)) {
+      out += string.charAt(i);
+      continue;
+    }
+    if (c < 0x80) { out += hexTable[c]; continue; }
+    if (c < 0x800) { out += hexTable[0xc0 | (c >> 6)] + hexTable[0x80 | (c & 0x3f)]; continue; }
+    if (c < 0xd800 || c >= 0xe000) {
+      out += hexTable[0xe0 | (c >> 12)] + hexTable[0x80 | ((c >> 6) & 0x3f)] + hexTable[0x80 | (c & 0x3f)];
+      continue;
+    }
