+// ------------------------------------------- the project's own calls, from test/rates.test.js ----
+const ok = (rate) => ({ delay: 'none', hops: 0, hopStatus: 302, locKind: 0, status: 200, ctype: 'application/json', body: { k: 'rate', rate }, reset: false });
