+const getCase = fc
+  .record({ base: getBase, from: scalar, to: scalar, s: serverScript(timing) })
+  .map(({ base, from, to, s }) => ({ shape: 'get', base, from, to, payload: undefined, timeout: s.timeout, server: s.server }));
+const postCase = fc
+  .record({ base: postBase, payload, s: serverScript(timing) })
