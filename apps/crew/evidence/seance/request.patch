+  if (str.length === 0) return str;
+  const string = typeof str === 'string' ? str : String(str);
+  let out = '';
+  for (let i = 0; i < string.length; ++i) {
+    let c = string.charCodeAt(i);
+    if (c === 0x2d || c === 0x2e || c === 0x5f || c === 0x7e ||
+        (c >= 0x30 && c <= 0x39) || (c >= 0x41 && c <= 0x5a) || (c >= 0x61 && c <= 0x7a)) {
+      out += string.charAt(i);
+      continue;
+    }
+    if (c < 0x80) { out += hexTable[c]; continue; }
+    if (c < 0x800) { out += hexTable[0xc0 | (c >> 6)] + hexTable[0x80 | (c & 0x3f)]; continue; }
+    if (c < 0xd800 || c >= 0xe000) {
+      out += hexTable[0xe0 | (c >> 12)] + hexTable[0x80 | ((c >> 6) & 0x3f)] + hexTable[0x80 | (c & 0x3f)];
+      continue;
+    }
+    i += 1;
+    c = 0x10000 + (((c & 0x3ff) << 10) | (string.charCodeAt(i) & 0x3ff));
+    out += hexTable[0xf0 | (c >> 18)] + hexTable[0x80 | ((c >> 12) & 0x3f)] +
