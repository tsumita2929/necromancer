+// JSON codec for the séance's inputs and outcomes: JSON cannot hold undefined, NaN, -0,
+// Infinity, bigint, symbols or functions, so each is written as a tagged object.
+export function encode(v) {
+  if (v === undefined) return { t: 'undefined' };
+  if (v === null || typeof v === 'boolean' || typeof v === 'string') return v;
+  if (typeof v === 'number') return { t: 'number', v: Object.is(v, -0) ? '-0' : String(v) };
+  if (typeof v === 'bigint') return { t: 'bigint', v: v.toString() };
+  if (typeof v === 'symbol') return { t: 'symbol' };
+  if (typeof v === 'function') return { t: 'function' };
+  if (Array.isArray(v)) return { t: 'array', v: v.map(encode) };
+  if (typeof v.valueOf === 'function' && Object.prototype.hasOwnProperty.call(v, 'valueOf')) {
+    return { t: 'valueOf', v: encode(v.valueOf()) };
+  }
+  if (Object.keys(v).length === 0) return { t: 'object' };
+  throw new Error('codec: unsupported value');
+}
+
+export function decode(e) {
+  if (e === null || typeof e !== 'object') return e;
+  switch (e.t) {
+    case 'undefined': return undefined;
+    case 'number': return e.v === '-0' ? -0 : Number(e.v);
+    case 'bigint': return BigInt(e.v);
+    case 'symbol': return Symbol('x');
+    case 'function': return () => 1;
+    case 'array': return e.v.map(decode);
+    case 'valueOf': { const inner = decode(e.v); return { valueOf: () => inner }; }
+    case 'object': return {};
+    default: throw new Error('codec: unknown tag ' + e.t);
+  }
+}
