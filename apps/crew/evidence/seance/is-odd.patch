diff --git a/seance/is-odd/golden.test.mjs b/seance/is-odd/golden.test.mjs
new file mode 100644
index 0000000..0d42ca5
--- /dev/null
+++ b/seance/is-odd/golden.test.mjs
@@ -0,0 +1,28 @@
+// Replay: the project's isOdd against answers recorded from is-odd 3.0.1 (golden.json).
+// Needs no old package. Re-record with record-golden.mjs.
+import { readFileSync } from 'node:fs';
+import { describe, it, expect } from 'vitest';
+import { isOdd } from '../../src/vendor/is-odd.js';
+import { decode } from './codec.mjs';
+
+const golden = JSON.parse(readFileSync(new URL('./golden.json', import.meta.url), 'utf8'));
+
+const outcome = (fn, args) => {
+  try {
+    return { ok: true, value: fn(...args) };
+  } catch (e) {
+    return { ok: false, error: e && e.constructor ? e.constructor.name : typeof e };
+  }
+};
+
+describe('golden: owned isOdd replays the recorded answers of is-odd 3.0.1', () => {
+  it('has recorded answers', () => {
+    expect(golden.entries.length).toBeGreaterThan(3000);
+  });
+
+  it('answers the same on every recorded input', () => {
+    for (const { input, answer } of golden.entries) {
+      expect(outcome(isOdd, [decode(input)]), JSON.stringify(input)).toEqual(answer);
+    }
+  });
+});
diff --git a/seance/is-odd/record-golden.mjs b/seance/is-odd/record-golden.mjs
