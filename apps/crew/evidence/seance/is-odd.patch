+++ b/src/vendor/is-odd.mjs
@@ -0,0 +1,10 @@
+// is-odd, owned by the project. Generated by Necromancer (recipe "is-odd").
+// Dependency-free (is-odd also needed is-number). Kept identical to is-odd 3.0.1 for every
+// input the séance compares, including the unusual ones: strings, arrays, null, bigint.
+export function isOdd(value) {
+  const n = Math.abs(value); // converts like is-odd: "3" and [3] are 3, null is 0
+  if (!Number.isFinite(n)) throw new TypeError('expected a number');
+  if (!Number.isInteger(n)) throw new Error('expected an integer');
+  if (!Number.isSafeInteger(n)) throw new Error('value exceeds maximum safe integer');
+  return n % 2 === 1;
+}
