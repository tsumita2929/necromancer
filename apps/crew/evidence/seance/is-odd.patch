+// Séance: is-odd -> src/vendor/is-odd.mjs. Generated by Necromancer (recipe "is-odd").
+// Run: npx vitest run seance/is-odd
+//
+// Compared: the boolean returned or, when the call throws, the error class (never the message).
+import { describe, it, expect } from 'vitest';
+import fc from 'fast-check';
+import isOddOld from 'is-odd';
+import { isOdd } from '../../src/vendor/is-odd.mjs';
+
+const outcome = (fn, args) => {
+  try {
+    return { ok: true, value: fn(...args) };
+  } catch (e) {
+    return { ok: false, error: e && e.constructor ? e.constructor.name : typeof e };
+  }
+};
+
+// What a reader would try first.
+const naive = (n) => n % 2 === 1 || n % 2 === -1;
+
+const strangeNumbers = fc.constantFrom(0, -0, 1, -1, 2 ** 53, 2 ** 53 - 1, -(2 ** 53), 1e21, 1e-7, 0.5, -0.5, Infinity, -Infinity, NaN);
+const strange = fc.constantFrom(null, undefined, true, false, '', ' ', ' 5', '0x10', '-3', '3.5', 'abc', '9007199254740993', [], [3], [3, 4], {}, { valueOf: () => 3 }, Symbol('x'), 3n, () => 1);
+const value = fc.oneof(fc.integer(), fc.maxSafeInteger(), fc.double({ noNaN: false }), strangeNumbers, strange, fc.string(), fc.bigInt(), fc.integer().map(String), fc.array(fc.integer(), { maxLength: 2 }));
+
+// Calls the project makes today, from the usage scan (empty when none was given).
+const projectCalls = [];
+
+describe('seance: is-odd -> owned function', () => {
+  it('the owned function answers like is-odd for any value', () => {
+    fc.assert(
+      fc.property(value, (v) => {
+        expect(outcome(isOdd, [v])).toEqual(outcome(isOddOld, [v]));
+      }),
+      { numRuns: 3000 },
+    );
+  });
+
+  it('it answers like is-odd for every integer in a window around zero and around the safe limit', () => {
+    for (let n = -300; n <= 300; n++) expect(outcome(isOdd, [n])).toEqual(outcome(isOddOld, [n]));
+    // A step counter, not n++: above 2^53 adding 1 to a double changes nothing.
+    for (let k = -300; k <= 300; k++) {
+      const n = Number.MAX_SAFE_INTEGER + k;
+      expect(outcome(isOdd, [n]), String(n)).toEqual(outcome(isOddOld, [n]));
+      expect(outcome(isOdd, [-n]), String(-n)).toEqual(outcome(isOddOld, [-n]));
+    }
+  });
+
+  it('it answers like is-odd on the calls this project makes', () => {
+    for (const args of projectCalls) expect(outcome(isOdd, args), JSON.stringify(args)).toEqual(outcome(isOddOld, args));
+  });
+
+  it('the naive rewrite n % 2 === 1 is not the same function', () => {
+    // Values on which the obvious rewrite answers differently from is-odd.
+    const differing = [3.5, 2 ** 53, "abc", undefined, {}];
+    for (const v of differing) {
+      expect(outcome(naive, [v]), String(v)).not.toEqual(outcome(isOddOld, [v]));
+      expect(outcome(isOdd, [v]), String(v)).toEqual(outcome(isOddOld, [v]));
+    }
+  });
+});
