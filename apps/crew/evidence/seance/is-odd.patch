index 0000000..5b5f8c4
--- /dev/null
+++ b/seance/is-odd/record-golden.mjs
@@ -0,0 +1,34 @@
+// Records the answers of the original is-odd for a fixed seed into golden.json.
+// Needs the old package: npm install --no-save is-odd@3.0.1 && node seance/is-odd/record-golden.mjs
+// The generators are the ones in seance.test.mjs.
+import { writeFileSync } from 'node:fs';
+import fc from 'fast-check';
+import isOddOld from 'is-odd';
+import { encode } from './codec.mjs';
+
+const SEED = 20261104;
+
+const outcome = (fn, args) => {
+  try {
+    return { ok: true, value: fn(...args) };
+  } catch (e) {
+    return { ok: false, error: e && e.constructor ? e.constructor.name : typeof e };
+  }
+};
