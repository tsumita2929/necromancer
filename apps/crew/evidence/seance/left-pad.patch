+// Records left-pad 1.3.0's answers for a fixed seed into golden.json, so the new code stays
+// guarded after left-pad is removed. Written by hand; it draws from the séance's own generators
+// (generators.mjs). Needs the old package for this one run:
+//   npm install --no-save left-pad@1.3.0 && node seance/left-pad/record-golden.mjs
+import { writeFileSync } from 'node:fs';
+import fc from 'fast-check';
+import leftPadOld from 'left-pad';
+import { str, len, fill, oldBug, outcome, projectCalls, encode } from './generators.mjs';
+
+const SEED = 20260101;
+const known = [['abc', 6, ''], ['abc', 6, 'xy'], ['abc', 6, null], ['abc', Infinity, '-']];
+
+const three = fc.sample(fc.tuple(str, len, fill), { seed: SEED, numRuns: 2000 });
+const two = fc.sample(fc.tuple(str, len), { seed: SEED + 1, numRuns: 500 });
+
+const calls = [...known, ...projectCalls, ...three, ...two].filter(
+  (args) => !oldBug(args[0], args[1], args[2]),
+);
+
+const entries = calls.map((args) => ({ args: encode(args), result: encode(outcome(leftPadOld, args)) }));
+const golden = { package: 'left-pad', version: '1.3.0', seed: SEED, entries };
+writeFileSync(new URL('./golden.json', import.meta.url), JSON.stringify(golden) + '\n');
+console.log(`recorded ${entries.length} calls`);
