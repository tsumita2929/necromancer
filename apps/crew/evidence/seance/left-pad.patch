@@ -0,0 +1,120 @@
+// Séance: left-pad -> String.prototype.padStart. Generated by Necromancer (recipe "left-pad").
+// Run: npx vitest run seance/left-pad
+//
+// Asks left-pad and the replacement the same generated questions and fails on any different
+// answer. Compared: the returned string or, when the call throws, the error class (never the
+// message). Lengths of 2^31 or more are not generated: left-pad wraps them around.
+import { describe, it, expect } from 'vitest';
+import fc from 'fast-check';
+import leftPadOld from 'left-pad';
+import { leftPad } from './replacement.mjs';
+
+const outcome = (fn, args) => {
+  try {
+    return { ok: true, value: fn(...args) };
+  } catch (e) {
+    return { ok: false, error: e && e.constructor ? e.constructor.name : typeof e };
+  }
+};
+
+// What a reader would try first. The séance shows it is not the same.
+const naive = (str, len, ch) => String(str).padStart(len, ch);
+
+// Generators: values the real function is called with, plus the awkward ones.
+const str = fc.oneof(
+  fc.string({ maxLength: 8 }),
+  fc.constantFrom('', ' ', 'abc', '\u00e9', '\ud83d\ude00'),
+  fc.integer(),
+  fc.constantFrom(null, undefined, true, false, 0),
+);
+const len = fc.oneof(
+  fc.integer({ min: -5, max: 40 }),
+  fc.double({ min: -5, max: 40, noNaN: true }),
+  fc.constantFrom(NaN, Infinity, -Infinity, '7', '', '3.5', null, undefined, true),
+);
+const fill = fc.oneof(
+  fc.constant(undefined),
+  fc.constant(null),
+  fc.string({ maxLength: 3 }),
+  fc.integer({ min: 0, max: 9 }),
+  fc.constantFrom('', ' ', 0, false, true, NaN, '\ud83d\ude00'),
+);
+
+// left-pad bug, not reproduced: a fractional length below 10 with a space fill reads a
+// missing cache entry and answers "undefined" + str. The replacement pads instead.
+const oldBug = (s, n, c) => {
+  const missing = n - (s + '').length;
+  const space = (!c && c !== 0) || (c + '') === ' ';
+  return space && Number.isFinite(missing) && missing > 0 && missing < 10 && !Number.isInteger(missing);
+};
+
+// Calls the project makes today, from the usage scan (empty when none was given).
+// Written by hand: the scan found 4 calls in src/receipt.js but none with literal arguments.
+// These are the real argument lists, with the fills a caller can pass through options.fill.
+const projectCalls = [
+  [42, 8, '0'], // order number (a number)
+  [0, 8, '0'],
+  [123456789, 8, '0'], // longer than the width
+  ['x2', 4], // quantity column
+  ['x12345', 4],
+  ['$3.50', 10], // money column, default fill
+  ['$3.50', 10, ' '],
+  ['$3.50', 10, '.'],
+  ['$3.50', 10, '*'],
+  ['$3.50', 10, ''], // options.fill = ''
+  ['$3.50', 10, 'ab'], // options.fill with several characters
+  ['$3.50', 10, null],
+  ['$3.50', 10, 0],
+  ['$12345678.90', 10, '.'], // wider than the column
+  ['€0.00', 10, '-'],
+];
+
+describe('seance: left-pad -> String.prototype.padStart', () => {
+  it('the replacement answers like left-pad for any string, length and fill', () => {
+    fc.assert(
+      fc.property(str, len, fill, (s, n, c) => {
+        fc.pre(!oldBug(s, n, c));
+        expect(outcome(leftPad, [s, n, c])).toEqual(outcome(leftPadOld, [s, n, c]));
+      }),
+      { numRuns: 2000 },
+    );
+  });
+
+  it('the replacement answers like left-pad when the fill is left out', () => {
+    fc.assert(
+      fc.property(str, len, (s, n) => {
+        fc.pre(!oldBug(s, n, undefined));
+        expect(outcome(leftPad, [s, n])).toEqual(outcome(leftPadOld, [s, n]));
+      }),
+      { numRuns: 500 },
+    );
+  });
+
+  it('the replacement answers like left-pad on the calls this project makes', () => {
+    for (const args of projectCalls) {
+      expect(outcome(leftPad, args), JSON.stringify(args)).toEqual(outcome(leftPadOld, args));
+    }
+  });
+
+  // Known differences, found by this séance. Each input must still show a difference for
+  // the naive call; if one stops differing, the list is out of date.
+  const knownInputs = [['abc', 6, ''], ['abc', 6, 'xy'], ['abc', 6, null], ['abc', Infinity, '-']];
+  it('the naive String.prototype.padStart differs from left-pad on the known inputs', () => {
+    for (const args of knownInputs) {
+      expect(outcome(naive, args), JSON.stringify(args)).not.toEqual(outcome(leftPadOld, args));
+      expect(outcome(leftPad, args), JSON.stringify(args)).toEqual(outcome(leftPadOld, args));
+    }
+  });
+
+  it('the replacement pads where left-pad answers undefined (a left-pad bug, not reproduced)', () => {
+    expect(leftPadOld("abc", 5.5)).toBe("undefinedabc");
+    expect(leftPad("abc", 5.5)).toBe("  abc");
+  });
+
+  it('on the known inputs left-pad answers as documented', () => {
+    expect(leftPadOld("abc", 6, "")).toBe("   abc");
+    expect(leftPadOld("abc", 6, "xy")).toBe("xyxyxyabc");
+    expect(leftPadOld("abc", 6, null)).toBe("   abc");
+    expect(leftPadOld("abc", Infinity, "-")).toBe("abc");
+  });
+});
