+// Replay guard, written by hand. Checks the project's leftPad against the answers left-pad 1.3.0
+// gave for a fixed seed (golden.json, made by record-golden.mjs). It needs no old package.
+import { describe, it, expect } from 'vitest';
+import { readFileSync } from 'node:fs';
+import leftPad from '../../src/vendor/left-pad.js';
+import { outcome, encode, decode } from './generators.mjs';
+
+const golden = JSON.parse(readFileSync(new URL('./golden.json', import.meta.url), 'utf8'));
+
+describe('golden: leftPad replays left-pad 1.3.0', () => {
+  it('has recorded calls', () => {
+    expect(golden.entries.length).toBeGreaterThan(2000);
+  });
+
+  it('the codec round-trips awkward values', () => {
+    const sample = [undefined, NaN, -0, Infinity, -Infinity, null, 0, '', 'a', [1, , 3]];
+    const holes = decode(JSON.parse(JSON.stringify(encode([1, , 3]))));
+    expect(1 in holes).toBe(false);
+    const back = decode(JSON.parse(JSON.stringify(encode(sample))));
+    expect(Object.is(back[2], -0)).toBe(true);
+    expect(back).toEqual(sample);
+    expect(back.length).toBe(10);
+    expect(9 in back).toBe(true);
+  });
+
+  it('answers every recorded call as left-pad did', () => {
+    for (const { args, result } of golden.entries) {
+      const decoded = decode(args);
+      expect(encode(outcome(leftPad, decoded)), JSON.stringify(args)).toEqual(result);
+    }
+  });
+});
