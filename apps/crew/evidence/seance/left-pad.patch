+'use strict';
+
+// Project-owned replacement for the dead `left-pad` package (1.3.0). No dependencies.
+// Generated by Necromancer (recipe "left-pad"), as CommonJS.
+//
+// String.prototype.padStart is NOT a drop-in: it differs for an empty, multi-character or
+// non-string fill and for lengths that are not finite. This function keeps left-pad's answers.
+// One deliberate exception: left-pad answers "undefined" + str for a fractional length below 10
+// with a space fill (a bug); this pads instead.
+// See .kiro/specs/migrate-off-left-pad/design.md ("Known behavioural differences").
+function leftPad(str, len, ch) {
+  str = str + '';
+  // left-pad counts the missing characters with a 32-bit truncation; Math.trunc is the same
+  // for every length below 2^31.
+  const missing = Math.trunc(len - str.length);
+  if (!(missing > 0) || !Number.isFinite(missing)) return str;
+  if (!ch && ch !== 0) ch = ' ';
+  return (ch + '').repeat(missing) + str;
+}
+
+module.exports = leftPad;
+module.exports.leftPad = leftPad;
