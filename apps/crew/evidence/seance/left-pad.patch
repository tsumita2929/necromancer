+// Replacement for left-pad. Generated by Necromancer (recipe "left-pad").
+// Dependency-free. It answers like left-pad 1.3.0 for every input the séance compares.
+//
+// String.prototype.padStart is NOT a drop-in: it differs for an empty, multi-character or
+// non-string fill and for lengths that are not finite. This function keeps left-pad's answers.
+// If you decide that padStart's answers are what you want, call padStart directly and delete
+// the "naive" expectations in seance.test.mjs.
+export function leftPad(str, len, ch) {
+  str = str + '';
+  // left-pad counts the missing characters with a 32-bit truncation; Math.trunc is the same
+  // for every length the séance compares (below 2^31).
+  const missing = Math.trunc(len - str.length);
+  if (!(missing > 0) || !Number.isFinite(missing)) return str;
+  if (!ch && ch !== 0) ch = ' ';
+  return (ch + '').repeat(missing) + str;
+}
