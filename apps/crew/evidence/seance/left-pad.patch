+// Generators and helpers shared by the séance, the golden recorder and the golden replay.
+// The generators, `oldBug` and `outcome` are moved here unchanged from seance.test.mjs so the
+// recorder draws from exactly the same values. The codec is written by hand (see golden.test.mjs).
+import fc from 'fast-check';
+
+export const outcome = (fn, args) => {
+  try {
+    return { ok: true, value: fn(...args) };
+  } catch (e) {
+    return { ok: false, error: e && e.constructor ? e.constructor.name : typeof e };
+  }
+};
+
+// Generators: values the real function is called with, plus the awkward ones.
+export const str = fc.oneof(
+  fc.string({ maxLength: 8 }),
+  fc.constantFrom('', ' ', 'abc', '\u00e9', '\ud83d\ude00'),
+  fc.integer(),
+  fc.constantFrom(null, undefined, true, false, 0),
+);
+export const len = fc.oneof(
+  fc.integer({ min: -5, max: 40 }),
+  fc.double({ min: -5, max: 40, noNaN: true }),
+  fc.constantFrom(NaN, Infinity, -Infinity, '7', '', '3.5', null, undefined, true),
+);
+export const fill = fc.oneof(
+  fc.constant(undefined),
+  fc.constant(null),
+  fc.string({ maxLength: 3 }),
+  fc.integer({ min: 0, max: 9 }),
+  fc.constantFrom('', ' ', 0, false, true, NaN, '\ud83d\ude00'),
+);
+
+// left-pad bug, not reproduced: a fractional length below 10 with a space fill reads a
+// missing cache entry and answers "undefined" + str. The replacement pads instead.
+export const oldBug = (s, n, c) => {
+  const missing = n - (s + '').length;
+  const space = (!c && c !== 0) || (c + '') === ' ';
+  return space && Number.isFinite(missing) && missing > 0 && missing < 10 && !Number.isInteger(missing);
+};
+
+// Calls the project makes today, from the usage scan (empty when none was given).
+// Written by hand: the scan found 4 calls in src/receipt.js but none with literal arguments.
+// These are the real argument lists, with the fills a caller can pass through options.fill.
+export const projectCalls = [
+  [42, 8, '0'], // order number (a number)
+  [0, 8, '0'],
+  [123456789, 8, '0'], // longer than the width
+  ['x2', 4], // quantity column
+  ['x12345', 4],
+  ['$3.50', 10], // money column, default fill
+  ['$3.50', 10, ' '],
+  ['$3.50', 10, '.'],
+  ['$3.50', 10, '*'],
+  ['$3.50', 10, ''], // options.fill = ''
+  ['$3.50', 10, 'ab'], // options.fill with several characters
+  ['$3.50', 10, null],
+  ['$3.50', 10, 0],
+  ['$12345678.90', 10, '.'], // wider than the column
+  ['€0.00', 10, '-'],
+];
+
+// Codec for JSON: undefined, NaN, -0, Infinity, -Infinity and array holes do not survive
+// JSON.stringify, so they are written as { $: "<tag>" }. Everything else is plain JSON.
+export function encode(v) {
+  if (v === undefined) return { $: 'undefined' };
+  if (typeof v === 'number') {
+    if (Number.isNaN(v)) return { $: 'NaN' };
+    if (v === Infinity) return { $: 'Infinity' };
+    if (v === -Infinity) return { $: '-Infinity' };
+    if (Object.is(v, -0)) return { $: '-0' };
+    return v;
+  }
+  if (Array.isArray(v)) {
+    const out = [];
+    for (let i = 0; i < v.length; i++) out.push(i in v ? encode(v[i]) : { $: 'hole' });
+    return out;
+  }
+  if (v && typeof v === 'object') {
+    return Object.fromEntries(Object.entries(v).map(([k, x]) => [k, encode(x)]));
+  }
+  return v;
+}
+
+export function decode(v) {
+  if (Array.isArray(v)) {
+    const out = new Array(v.length);
+    v.forEach((x, i) => {
+      if (!(x && typeof x === 'object' && x.$ === 'hole')) out[i] = decode(x);
+    });
+    return out;
+  }
+  if (v && typeof v === 'object') {
+    if (typeof v.$ === 'string' && Object.keys(v).length === 1) {
+      return { undefined: undefined, NaN: NaN, Infinity: Infinity, '-Infinity': -Infinity, '-0': -0 }[v.$];
+    }
+    return Object.fromEntries(Object.entries(v).map(([k, x]) => [k, decode(x)]));
+  }
+  return v;
+}
