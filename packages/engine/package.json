{
  "name": "@necromancer/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Vital-signs engine: finds dead dependencies and writes the migration spec.",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "record-fixtures": "node scripts/record-fixtures.mjs",
    "measure-cors": "node scripts/measure-cors.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "is-odd": "^3.0.1",
    "left-pad": "^1.3.0",
    "mkdirp": "^1.0.4",
    "prettier": "^3.9.10",
    "querystring": "^0.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
